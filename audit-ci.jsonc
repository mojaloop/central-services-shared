{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [ // NOTE: Please add as much information as possible to any items added to the allowList
    // GHSA-h67p-54hq-rp68 — js-yaml quadratic-complexity DoS via merge keys.
    // Dev-only path: nyc (>@istanbuljs/load-nyc-config) and tap-xunit (>tap-parser), both test tooling.
    // No non-breaking fix: the fixed js-yaml@4.2.0 cannot be overridden onto the ^3.x consumers without breaking their API.
    // Not in the published runtime surface. TODO: revisit when nyc/tap-xunit ship a patched js-yaml.
    "GHSA-h67p-54hq-rp68"
  ]
}